{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "change-me",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",

  // Dashboard is served from ./public, but the Worker runs first so it can
  // gate every path behind a session cookie. Nothing here is world-open.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "change-me",
      "database_id": "PASTE_D1_UUID"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "PASTE_KV_ID"
    }
  ],

  "vars": {
    "ENVIRONMENT": "production",
    "MAX_FANOUT_CONCURRENCY": "6",
    "PER_ACCOUNT_TIMEOUT_MS": "15000",
    "TOKEN_REFRESH_SKEW_SECONDS": "300"
  },
  // SWEEPS ARE OPT-IN. Uncomment this block AND the "triggers" line after creating
  // the queues:  wrangler queues create change-me-sweeps
  //              wrangler queues create change-me-sweeps-dlq
  // Without them the Worker deploys and runs; /api/sweeps/:id/run returns a clear 503.
  // "queues": {
  // "producers": [
  // { "binding": "SWEEP_QUEUE", "queue": "change-me-sweeps" }
  // ],
  // "consumers": [
  // {
  // "queue": "change-me-sweeps",
  // "max_batch_size": 10,
  // "max_batch_timeout": 5,
  // "max_retries": 3,
  // "dead_letter_queue": "change-me-sweeps-dlq"
  // }
  // ]
  // },
  // "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true }

  // Phase 4 adds:  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "google-orchestrator-artifacts" }]
  // Phase 5 adds:  queues producer/consumer + SweepRunner durable object + [triggers] crons
}
